+package net.minecraft.server.commands;
+
+import com.mojang.brigadier.CommandDispatcher;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.AGCCommandReports;
+import net.minecraft.server.AGCCompatibilityBridge;
+import net.minecraft.server.AGCPerformanceGovernor;
+import net.minecraft.server.AGCRuntimeHealth;
+
+/** Operator diagnostics for AGC runtime state. */
+public final class AGCCommand {
+    private AGCCommand() {
+    }
+
+    public static void register(final CommandDispatcher<CommandSourceStack> dispatcher) {
+        dispatcher.register(
+            Commands.literal("agc")
+                .requires(Commands.hasPermission(Commands.LEVEL_OWNERS))
+                .executes(context -> sendReport(context.getSource(), overview()))
+                .then(Commands.literal("perf").executes(context -> sendReport(context.getSource(), AGCCommandReports.perf())))
+                .then(Commands.literal("compat").executes(context -> sendReport(context.getSource(), AGCCommandReports.compat())))
+                .then(Commands.literal("rollback-profile").executes(context -> sendReport(context.getSource(), AGCCommandReports.rollbackProfile())))
+                .then(Commands.literal("health").executes(context -> sendReport(context.getSource(), AGCRuntimeHealth.INSTANCE.statusLine())))
+                .then(Commands.literal("reset-rollback")
+                    .executes(context -> {
+                        AGCPerformanceGovernor.INSTANCE.resetManualForTestingOnly();
+                        AGCCompatibilityBridge.invalidatePluginScan();
+                        return sendReport(context.getSource(), "AGC rollback state cleared for this process. Re-check /agc compat before enabling experimental features.");
+                    })
+                )
+        );
+    }
+
+    private static String overview() {
+        return String.join("\n",
+            "AGC diagnostics:",
+            "  /agc perf - runtime budgets, admissions and rollback governor",
+            "  /agc compat - plugin compatibility scan and parallel tick gate",
+            "  /agc health - last server tick health sample",
+            "  /agc rollback-profile - rollback counters",
+            "  /agc reset-rollback - clear AGC runtime rollback flags for this process"
+        );
+    }
+
+    private static int sendReport(final CommandSourceStack source, final String report) {
+        if (report == null || report.isBlank()) {
+            source.sendSuccess(() -> Component.literal("AGC: no report data"), false);
+            return 1;
+        }
+        final String[] lines = report.split("\\R", -1);
+        for (final String line : lines) {
+            if (!line.isBlank()) {
+                source.sendSuccess(() -> Component.literal(line), false);
+            }
+        }
+        return lines.length;
+    }
+}
