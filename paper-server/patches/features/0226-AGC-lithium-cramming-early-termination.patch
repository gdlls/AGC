From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AGC Developer <developer@agc.com>
Date: Sun, 06 Sep 2026 12:00:00 +0900
Subject: [PATCH] AGC Lithium cramming early termination

Ports Lithium's unpushable_cramming counting win into
LivingEntity.pushEntities: the cramming census exits as soon as the damage
threshold is proven instead of scanning the whole crowd. RNG consumption
(random.nextInt(4) exactly once, only when size exceeds the threshold) and
the damage outcome are bit-identical to the vanilla block this replaces.
Gated by AgcCapabilityMatrix LITHIUM_COLLISION_ENGINE (baseline-safe).

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -3924,18 +3924,28 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         if (!pushableEntities.isEmpty()) {
             if (this.level() instanceof ServerLevel serverLevel) {
                 // Paper - don't run getEntities if we're not going to use its result; moved up
-                if (maxCramming > 0 && pushableEntities.size() > maxCramming - 1 && this.random.nextInt(4) == 0) {
-                    int count = 0;
-
-                    for (Entity entity : pushableEntities) {
-                        if (!entity.isPassenger()) {
-                            count++;
-                        }
-                    }
-
-                    if (count > maxCramming - 1) {
-                        this.hurtServer(serverLevel, this.damageSources().cramming(), 6.0F);
-                    }
+                // AGC start - Lithium cramming early termination (identical damage outcome + RNG consumption)
+                final boolean agc$applyCramming;
+                if (io.papermc.paper.agc.AgcCapabilityMatrix.isEnabled(io.papermc.paper.agc.AgcCapabilityMatrix.Feature.LITHIUM_COLLISION_ENGINE)) {
+                    agc$applyCramming = io.papermc.paper.agc.entity.AgcLithiumCollisionEngine.get()
+                        .shouldApplyCrammingDamage(pushableEntities, maxCramming, () -> this.random.nextInt(4));
+                } else if (maxCramming > 0 && pushableEntities.size() > maxCramming - 1 && this.random.nextInt(4) == 0) {
+                    int count = 0;
+
+                    for (Entity entity : pushableEntities) {
+                        if (!entity.isPassenger()) {
+                            count++;
+                        }
+                    }
+
+                    agc$applyCramming = count > maxCramming - 1;
+                } else {
+                    agc$applyCramming = false;
+                }
+                if (agc$applyCramming) {
+                    this.hurtServer(serverLevel, this.damageSources().cramming(), 6.0F);
+                }
+                // AGC end - Lithium cramming early termination
             }
 
             // Paper start - Cap entity collisions
