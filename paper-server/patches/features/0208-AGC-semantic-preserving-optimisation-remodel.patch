From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AGC Developer <developer@agc.com>
Date: Fri, 26 Jun 2026 22:10:00 +0900
Subject: [PATCH] AGC semantic-preserving optimisation remodel

Alpha8 wires the world tick selector into the semantic planner and exposes the
new invariant diagnostics. Full parallel world waves are selected only when the
planner proves Bukkit-visible callbacks and world mutations remain deterministic.

--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -2013,13 +2013,18 @@
         // Meteus end - server world tick loop fast path
         // Meteus start - server level snapshot iteration fast path
         final ServerLevel[] meteus$levels = io.papermc.paper.configuration.GlobalConfiguration.get().agc.performance.serverLevelSnapshotIterationFastPath ? this.meteus$getServerLevelSnapshot() : null;
-        // Meteus start - parallel world tick: tick independent worlds across the worker pool + main thread, barrier, then drain deferred cross-world transfers
+        // AGC start - semantic world planner: build a conflict graph every tick. Full parallel waves are used only when the planner proves
+        // Bukkit-visible callbacks and world mutations remain deterministic; otherwise the normal ordered commit loop below still benefits
+        // from AGC's read-only planning/accounting without moving plugin work to worker threads.
+        if (meteus$levels != null) {
+            net.minecraft.server.AGCWorldConcurrencyPlanner.INSTANCE.buildPlan(meteus$levels);
+        }
         if (meteus$levels != null
-                && net.minecraft.server.AGCCompatibilityBridge.shouldEnableExperimentalParallelWorldTick()
+                && net.minecraft.server.AGCCompatibilityBridge.shouldEnableExperimentalParallelWorldTick(meteus$levels)
                 && meteus$levels.length >= Math.max(2, io.papermc.paper.configuration.GlobalConfiguration.get().agc.performance.parallelWorldTickMinWorlds)) {
             this.meteus$tickLevelsParallel(meteus$levels, haveTime, meteus$serverWorldTickLoopFastPath, meteus$hasPhysicsEvent, meteus$hasEntityMoveEvent, meteus$hasInventoryMoveEvent);
         } else
-        // Meteus end - parallel world tick
+        // AGC end - semantic world planner
         if (meteus$levels != null) {
             for (int meteus$levelIndex = 0, meteus$levelLen = meteus$levels.length; meteus$levelIndex < meteus$levelLen; ++meteus$levelIndex) {
                 final ServerLevel level = meteus$levels[meteus$levelIndex];

--- a/net/minecraft/server/commands/AGCCommand.java
+++ b/net/minecraft/server/commands/AGCCommand.java
@@ -24,6 +24,7 @@
                 .then(Commands.literal("profile").executes(context -> sendReport(context.getSource(), AGCCommandReports.profile())))
                 .then(Commands.literal("journal").executes(context -> sendReport(context.getSource(), AGCCommandReports.journal())))
                 .then(Commands.literal("safety").executes(context -> sendReport(context.getSource(), AGCCommandReports.safety())))
+                .then(Commands.literal("semantics").executes(context -> sendReport(context.getSource(), AGCCommandReports.safety())))
                 .then(Commands.literal("api").executes(context -> sendReport(context.getSource(), AGCCommandReports.minigameApi())))
                 .then(Commands.literal("rollback-profile").executes(context -> sendReport(context.getSource(), AGCCommandReports.rollbackProfile())))
                 .then(Commands.literal("health").executes(context -> sendReport(context.getSource(), AGCRuntimeHealth.INSTANCE.statusLine())))
@@ -46,6 +47,7 @@
             "  /agc profile - adaptive scaling profile state",
             "  /agc journal - recent AGC safety/profile events",
             "  /agc safety - central optimisation envelope and compatibility status",
+            "  /agc semantics - semantic invariant ledger and world planner status",
             "  /agc api - mini-game API status",
             "  /agc rollback-profile - rollback counters",
             "  /agc reset-rollback - clear AGC runtime rollback flags for this process"
