From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AGC Developer <developer@agc.com>
Date: Fri, 26 Jun 2026 21:30:00 +0900
Subject: [PATCH] AGC optimisation envelope safety command

Expose the alpha7 central optimisation envelope through /agc safety so
operators can confirm that aggressive-compatible defaults are still failing open
toward Paper-compatible behaviour when plugin or latency risk is detected.

diff --git a/net/minecraft/server/commands/AGCCommand.java b/net/minecraft/server/commands/AGCCommand.java
--- a/net/minecraft/server/commands/AGCCommand.java	2026-06-26 12:21:12.899816656 +0000
+++ b/net/minecraft/server/commands/AGCCommand.java	2026-06-26 12:37:07.417208831 +0000
@@ -23,6 +23,7 @@
                 .then(Commands.literal("compat").executes(context -> sendReport(context.getSource(), AGCCommandReports.compat())))
                 .then(Commands.literal("profile").executes(context -> sendReport(context.getSource(), AGCCommandReports.profile())))
                 .then(Commands.literal("journal").executes(context -> sendReport(context.getSource(), AGCCommandReports.journal())))
+                .then(Commands.literal("safety").executes(context -> sendReport(context.getSource(), AGCCommandReports.safety())))
                 .then(Commands.literal("api").executes(context -> sendReport(context.getSource(), AGCCommandReports.minigameApi())))
                 .then(Commands.literal("rollback-profile").executes(context -> sendReport(context.getSource(), AGCCommandReports.rollbackProfile())))
                 .then(Commands.literal("health").executes(context -> sendReport(context.getSource(), AGCRuntimeHealth.INSTANCE.statusLine())))
@@ -44,6 +45,7 @@
             "  /agc health - last server tick health sample",
             "  /agc profile - adaptive scaling profile state",
             "  /agc journal - recent AGC safety/profile events",
+            "  /agc safety - central optimisation envelope and compatibility status",
             "  /agc api - mini-game API status",
             "  /agc rollback-profile - rollback counters",
             "  /agc reset-rollback - clear AGC runtime rollback flags for this process"
